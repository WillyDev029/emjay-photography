# Copy this file to `.env.local` for local development.
# All values also need to be set as environment variables in Render
# (Dashboard → your static site → Environment).

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL, used for canonical links and Open Graph images.
# Use your final live URL (e.g. https://my-site.onrender.com or custom domain).
VITE_APP_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173