# Copy this file to `.env.local` for local development.
# All values also need to be set as environment variables in Render
# (Dashboard → your static site → Environment).

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL, used for canonical links and Open Graph images.
# If unset, production builds fall back to https://emjay-photography.onrender.com
# and local dev falls back to http://localhost:5173. Set only if you use a
# custom domain (e.g. https://your-domain.com).
VITE_APP_URL=
VITE_SITE_URL=